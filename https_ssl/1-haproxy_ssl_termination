global
    log /dev/log local0
    maxconn 2048
    user haproxy
    group haproxy
    daemon
    tune.ssl.default-dh-param 2048

defaults
    log global
    mode http
    option httplog
    option dontlognull
    option forwardfor
    timeout connect 5000
    timeout client 50000
    timeout server 50000

frontend www-https
    bind *:443 ssl crt /etc/haproxy/certs/www.yourdomain.tech.pem
    http-request set-header X-Forwarded-Proto https
    default_backend web-backend

backend web-backend
    balance roundrobin
    server 7234-web-01 3.8.119.106:80 check
    server 7234-web-02 18.175.146.19:80 check
