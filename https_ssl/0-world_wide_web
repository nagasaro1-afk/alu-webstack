#!/usr/bin/env bash
# Displays info about subdomains of a domain
# shellcheck disable=SC2086

get_info() {
    dig "$2.$1" | grep -A1 'ANSWER SECTION:' | tail -n1 | awk -v s="$2" '{print "The subdomain " s " is a " $4 " record and points to " $5}'
}

if [ "$#" -eq 1 ]; then
    for sub in www lb-01 web-01 web-02; do
        get_info "$1" "$sub"
    done
else
    get_info "$1" "$2"
fi
